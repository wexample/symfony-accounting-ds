{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyAccountingDsBundle/components/invoice-item-grid') -}}
{%- endblock -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyAccountingDsBundle.components.invoice-editor.invoice-editor::*') }}
{%- endblock -%}

{%- block vue_body -%}
    <div class="invoice-editor stack--vertical" :aria-busy="busy ? 'true' : null">
        {#- The head: who, when, what it is about. Each field saved as it is left. -#}
        <section class="block block--card">
            <div class="block--body invoice-editor--head">
                <label class="form--label">[[ t('head.party') ]]
                    <select class="form--input" v-model="head.party" @change="saveHead('party')">
                        <option value="">[[ t('head.no_party') ]]</option>
                        <option v-for="party in parties" :key="party.id" :value="party.id">[[ party.name ]]</option>
                    </select>
                </label>
                <label class="form--label">[[ t('head.title') ]]
                    <input class="form--input" v-model="head.title" @change="saveHead('title')">
                </label>
                <label class="form--label">[[ t('head.date') ]]
                    <input class="form--input" type="date" v-model="head.dateInvoice" @change="saveHead('dateInvoice')">
                </label>
                <label v-if="quotation" class="form--label">[[ t('head.valid_until') ]]
                    <input class="form--input" type="date" v-model="head.dateValidUntil" @change="saveHead('dateValidUntil')">
                </label>
                <label v-else class="form--label">[[ t('head.term') ]]
                    <input class="form--input" type="number" min="0" step="1" v-model="head.paymentTermDays" :placeholder="String(computed.paymentTermDaysDefault ?? '')" @change="saveHead('paymentTermDays')">
                </label>
                <label class="form--label">[[ t('head.currency') ]]
                    <input class="form--input" maxlength="3" v-model="head.currencyCode" @change="saveHead('currencyCode')">
                </label>
                <label v-if="foreign()" class="form--label">[[ t('head.rate', { '%currency%': currency }) ]]
                    <input class="form--input" inputmode="decimal" v-model="head.exchangeRate" :placeholder="t('head.rate_at_emission')" @change="saveHead('exchangeRate')">
                </label>
                <label class="form--label invoice-editor--note">[[ t('head.note') ]]
                    <textarea class="form--input" rows="2" v-model="head.note" @change="saveHead('note')"></textarea>
                </label>
            </div>
        </section>

        {#- The lines, written in place, then what they all come to. -#}
        <section class="block block--card">
            <div class="block--body">
                <invoice-item-grid
                        v-if="document"
                        :invoice="invoice"
                        :ledger="ledger"
                        :vat-rates="vatRates"
                        :currency-code="document.currencyCode || currency"
                        :locale-code="locale"
                        @changed="load"
                ></invoice-item-grid>
                <p class="invoice-editor--hint">[[ t('line.paste_hint') ]]</p>
            </div>
            <div class="block--footer invoice-editor--totals">
                <dl>
                    <dt>[[ t('total.net') ]]</dt><dd>[[ money(totals.net) ]]</dd>
                    <dt>[[ t('total.vat') ]]</dt><dd>[[ money(totals.vat) ]]</dd>
                    <dt>[[ t('total.total') ]]</dt><dd><strong>[[ money(totals.total) ]]</strong></dd>
                </dl>
                <a class="button button--flat" :href="pdfUrl" target="_blank" rel="noopener">[[ t('pdf') ]]</a>
            </div>
        </section>
    </div>
{%- endblock -%}
