{%- extends '@WexampleSymfonyLoaderBundle/bases/form.html.twig' -%}

{#- Who the ledger is, then how it keeps its books. -#}
{% block form_body %}
    <fieldset class="stack--vertical">
        <legend>{{ '@form::group.identity' | trans }}</legend>
        {{ form_widget(form.organization) }}
    </fieldset>
    <fieldset class="stack--vertical">
        <legend>{{ '@form::group.books' | trans }}</legend>
        {{ form_row(form.vatSubject) }}
        {{ form_row(form.vatPeriodicity) }}
        {{ form_row(form.vatOnPayments) }}
        {{ form_row(form.invoicePrefix) }}
        {{ form_row(form.paymentTermDays) }}
        {{ form_row(form.legalMentions) }}
    </fieldset>
    <fieldset class="stack--vertical">
        <legend>{{ '@form::group.vat' | trans }}</legend>
        {{ form_row(form.ossRegistered) }}
        {{ form_row(form.ossElectronicServices) }}
        {{ form_row(form.vatDeductionRate) }}
        {{ form_row(form.vatAdmissionRates) }}
    </fieldset>
    {%- if form.nbbCourt is defined -%}
        <fieldset class="stack--vertical">
            <legend>{{ '@form::group.nbb' | trans }}</legend>
            {{ form_row(form.nbbCourt) }}
            {{ form_row(form.nbbLastDeedDate) }}
            {{ form_row(form.nbbLegalForm) }}
        </fieldset>
    {%- endif -%}
    {{ form_actions(form) }}
{% endblock %}
