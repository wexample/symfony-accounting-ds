{%- extends '@WexampleSymfonyLoaderBundle/bases/form.html.twig' -%}

{% block form_body %}
    <fieldset class="stack--vertical">
        <legend>{{ '@form::group.who' | trans }}</legend>
        {{ form_row(form.name) }}
        <div class="cluster">
            {{ form_row(form.customer) }}
            {{ form_row(form.supplier) }}
            {{ form_row(form.individual) }}
        </div>
        {{ form_row(form.legalIdentifier) }}
        {{ form_row(form.vatNumber) }}
        {{ form_row(form.email) }}
        {{ form_row(form.phone) }}
        {{ form_row(form.postalAddress) }}
        {{ form_row(form.postCode) }}
        {{ form_row(form.city) }}
    </fieldset>
    <fieldset class="stack--vertical">
        <legend>{{ '@form::group.payment' | trans }}</legend>
        {{ form_row(form.iban) }}
        {{ form_row(form.paymentTermDays) }}
        {{ form_row(form.notes) }}
    </fieldset>
    {{ form_actions(form) }}
{% endblock %}
