{%- extends '@front/layouts/private/layout.html.twig' -%}

{#- A page of one ledger, read inside its organization: the organization's
    navigation (`organization_navigation`), where the books are a section of
    their own holding every view of the ledger (LedgerOrganizationSectionService)
    — as tabs, the ledger's views under the way back to the organization; as the
    side menu, the organization whole, the books unfolded. `ledger` is given by
    every page extending this one; the actions of the page, if any, at the far
    end of the bar (`ledger_actions`). -#}
{%- set page_show_title = true -%}
{%- set page_section_navigation = organization_navigation(ledger.organization)|merge({ actions: ledger_actions|default(null) }) -%}
