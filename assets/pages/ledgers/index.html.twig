{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{#- The ledgers the reader may open: who, where, what is owed to them and by
    them, the bank lines still to explain. -#}
{%- block page_body -%}
    {%- if ledgers is empty -%}
        <p class="fallback">{{ '@page::empty' | trans }}</p>
    {%- else -%}
        {{ data_table([
            { key: 'name', label: '@page::column.name' | trans },
            { key: 'country', label: '@page::column.country' | trans },
            { key: 'fiscal_year', label: '@page::column.fiscal_year' | trans },
            { key: 'receivable', label: '@page::column.receivable' | trans, align: 'end' },
            { key: 'payable', label: '@page::column.payable' | trans, align: 'end' },
            { key: 'unsettled', label: '@page::column.unsettled' | trans, align: 'end' },
        ], ledgers|map(row => {
            href: path('accounting_show', { id: row.ledger.id }),
            name: row.ledger.name,
            country: row.ledger.country ? row.ledger.country.isoAlpha2Code : '',
            fiscal_year: row.fiscalYear ? row.fiscalYear.label : '',
            receivable: row.receivable|price(row.ledger.currencyCode, app.request.locale),
            payable: row.payable|price(row.ledger.currencyCode, app.request.locale),
            unsettled: row.unsettled,
        }), { row_link: { key: 'href' } }) }}
    {%- endif -%}
{%- endblock -%}
