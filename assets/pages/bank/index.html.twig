{%- extends '@WexampleSymfonyAccountingDsBundle/layouts/ledger/layout.html.twig' -%}

{%- import '@WexampleSymfonyAccountingDsBundle/partials/macros.html.twig' as accounting -%}

{%- set ledger_actions = can_edit ? [
    { icon: 'ph:bold/magic-wand', label: '@page::action.match' | trans, href: path('accounting_bank_match', { ledger: ledger.id }), method: 'post', token: csrf_token('accounting') },
] : null -%}

{#- The accounts and their balance, a statement imported into one of them,
    then every line not explained yet, the oldest first. -#}
{%- block page_body -%}
    {%- set currency = ledger.currencyCode -%}
    {%- set locale = app.request.locale -%}
    <section class="block block--card">
        <div class="block--title"><span class="block--title-label">{{ '@page::accounts' | trans }}</span></div>
        <div class="block--body stack--vertical">
            {{ data_table([
                { key: 'label', label: '@page::column.account' | trans },
                { key: 'iban', label: 'IBAN' },
                { key: 'balance', label: '@page::column.balance' | trans, align: 'end' },
                { key: 'unsettled', label: '@page::column.unsettled' | trans, align: 'end' },
            ], accounts|map(row => {
                href: path('accounting_bank_account', { ledger: ledger.id, id: row.account.id }),
                label: row.account.label,
                iban: row.account.iban,
                balance: row.balance|price(currency, locale),
                unsettled: row.unsettled,
            }), { row_link: { key: 'href' }, empty_label: '@page::no_account' | trans }) }}
            {%- if can_edit -%}
                <form method="post" action="{{ path('accounting_bank_account_create', { ledger: ledger.id }) }}" class="cluster">
                    <input type="hidden" name="_token" value="{{ csrf_token('accounting') }}">
                    <input class="form--input" name="label" required placeholder="{{ '@page::new.label' | trans }}">
                    <input class="form--input" name="iban" placeholder="IBAN">
                    {{ button('ph:bold/plus', '@page::new.submit' | trans, { type: 'submit', class: 'button--flat' }) }}
                </form>
            {%- endif -%}
        </div>
    </section>

    {%- if can_edit and accounts is not empty -%}
        <section class="block block--card">
            <div class="block--title">
                <span class="block--title-leading">{{ icon('ph:bold/upload-simple') }}</span>
                <span class="block--title-label">{{ '@page::import.title' | trans }}</span>
            </div>
            <div class="block--body">
                <form method="post" enctype="multipart/form-data" action="{{ path('accounting_bank_import', { ledger: ledger.id }) }}" class="cluster">
                    <input type="hidden" name="_token" value="{{ csrf_token('accounting') }}">
                    <select class="form--input" name="account">
                        {%- for row in accounts -%}<option value="{{ row.account.id }}">{{ row.account.label }}</option>{%- endfor -%}
                    </select>
                    <select class="form--input" name="parser">
                        <option value="">{{ '@page::import.detect' | trans }}</option>
                        {%- for key, label in parsers -%}<option value="{{ key }}">{{ label }}</option>{%- endfor -%}
                    </select>
                    <input type="file" name="file" required>
                    {{ button('ph:bold/upload-simple', '@page::import.submit' | trans, { type: 'submit' }) }}
                </form>
            </div>
        </section>
    {%- endif -%}

    <section class="block block--card">
        <div class="block--title"><span class="block--title-label">{{ '@page::unsettled' | trans }}</span></div>
        <div class="block--body">
            {%- include '@WexampleSymfonyAccountingDsBundle/partials/bank_lines.html.twig' with { lines: unsettled, empty: '@page::all_settled' | trans } -%}
        </div>
    </section>
{%- endblock -%}
