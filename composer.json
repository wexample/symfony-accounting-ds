{
  "name": "wexample/symfony-accounting-ds",
  "version": "2.1.4",
  "type": "library",
  "license": "MIT",
  "description": "The interface of symfony-accounting: ledgers, documents and their editor, parties, chart, bank and reconciliation, entries, fiscal years, VAT, statements and exports",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyAccountingDs\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyAccountingDs\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=18.0.0",
    "wexample/symfony-loader": ">=25.0.0",
    "wexample/symfony-design-system": ">=39.0.0",
    "wexample/symfony-api": ">=14.0.0",
    "wexample/symfony-forms": ">=14.0.0",
    "wexample/symfony-money": ">=7.0.0",
    "wexample/symfony-geo": ">=8.0.0",
    "wexample/symfony-accounting": ">=8.0.0",
    "wexample/symfony-organization": ">=3.0.0",
    "wexample/symfony-organization-ds": ">=3.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}